{
  "name": "amadocs-desktop",
  "productName": "AMAdocs",
  "version": "0.1.0",
  "description": "Ask your documents anything — private, local AI for your files.",
  "main": "main.js",
  "author": "AMAdocs",
  "homepage": "https://github.com/gonzokawasaki/amadocs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.61.0"
  },
  "build": {
    "appId": "com.amadocs.app",
    "productName": "AMAdocs",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "ui/**/*"
    ],
    "extraResources": [
      {
        "from": "../anythingllm-upstream/server",
        "to": "engine/server",
        "filter": [
          "**/*",
          "!storage/**",
          "!.env*",
          "!**/*.log",
          "!node_modules/chromadb-js-bindings-linux-x64-gnu/**",
          "!node_modules/chromadb-default-embed/**",
          "!node_modules/onnxruntime-node/**",
          "!node_modules/onnxruntime-web/**",
          "!node_modules/@xenova/**",
          "!node_modules/flow-bin/**",
          "!node_modules/hermes-eslint/**",
          "!node_modules/flow-remove-types/**",
          "!node_modules/eslint/**",
          "!node_modules/eslint-*/**",
          "!node_modules/@eslint/**",
          "!node_modules/prettier/**",
          "!node_modules/nodemon/**",
          "!node_modules/@inquirer/**"
        ]
      },
      {
        "from": "../anythingllm-upstream/collector",
        "to": "engine/collector",
        "filter": [
          "**/*",
          "!storage/**",
          "!hotdir/**",
          "!.env*",
          "!**/*.log",
          "!node_modules/onnxruntime-node/**",
          "!node_modules/onnxruntime-web/**",
          "!node_modules/@xenova/**",
          "!node_modules/eslint/**",
          "!node_modules/eslint-*/**",
          "!node_modules/@eslint/**",
          "!node_modules/prettier/**",
          "!node_modules/nodemon/**"
        ]
      },
      {
        "from": "../anythingllm-upstream/server/storage/models",
        "to": "storage-seed/models",
        "filter": [
          "**/*",
          "!Xenova/**"
        ]
      },
      {
        "from": "vendor/anythingllm.db",
        "to": "storage-seed/anythingllm.db"
      },
      {
        "from": "vendor/node",
        "to": "node"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../THIRD_PARTY_LICENSES",
        "to": "THIRD_PARTY_LICENSES"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "category": "Office",
      "maintainer": "AMAdocs",
      "artifactName": "AMAdocs-${version}-${arch}.${ext}"
    }
  }
}
